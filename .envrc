PROJECT_DIR=$(dirname "$1")
SOURCES_DIR=$PROJECT_DIR/source

CONTENT_DIR="$SOURCES_DIR/content"
PRESENTATION_DIR="$SOURCES_DIR/presentation"
BEHAVIOR_DIR="$SOURCES_DIR/behavior"
BUILD_DIR="$PROJECT_DIR/build"
TEST_DIR="$PROJECT_DIR/test"
SPEC_DIR="$TEST_DIR/specs"
STOREY_DIR="$TEST_DIR/stories"
BRWUD_DIR="$PROJECT_DIR/.brwud"
COVERAGE_DIR="$PROJECT_DIR/coverage"

DIST_DIR="$PROJECT_DIR/distribution"
COMMON_DIR="$DIST_DIR/common"


export PROJECT_DIR
export SOURCES_DIR
export CONTENT_DIR
export PRESENTATION_DIR
export BEHAVIOR_DIR
export BUILD_DIR
export TEST_DIR
export SPEC_DIR
export STOREY_DIR
export BRWUD_DIR
export COVERAGE_DIR
export DIST_DIR
export COMMON_DIR


FHOST_URL_ROOT="file:///$DIST_DIR"

LHOST_PORT=54321
LHOST_URL="http://localhost:$LHOST_PORT/"

BRW_DBG_PORT=28133


export FHOST_URL_ROOT
export LHOST_PORT
export LHOST_URL
export BRW_DBG_PORT


# Aim for roughly 2 releaes in a calendar month except when a fix:
# 	(yearinfourdigits_monthintwodigits-numberofbuildintwodigits)
#	YYYY_MM-##
VERSION_NUM=$(sed -n "1p" ./VERSION)

DEV_VER="${VERSION_NUM%%-*}"
DEV_DIR=$DIST_DIR/$DEV_VER


export VERSION_NUM
export DEV_VER
export DEV_DIR
